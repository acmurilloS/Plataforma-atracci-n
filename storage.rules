rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Usuario interno (tiene rol en sus custom claims). Los candidatos entran con
    // auth ANÓNIMA y NO tienen rol, así que esto los excluye de lo sensible.
    function tieneRol() {
      return request.auth != null && request.auth.token.rol != null;
    }
    function esPdf() {
      return request.resource.contentType == 'application/pdf';
    }
    function esPdfOImagen() {
      return request.resource.contentType != null
        && (request.resource.contentType == 'application/pdf'
            || request.resource.contentType.matches('image/.*'));
    }
    // PDF + imagen + Word (.doc/.docx): para documentos del candidato donde se
    // admiten varios formatos (reu 26-jun). Los formatos OFICIALES/avales/CVs
    // siguen exigiendo PDF (esPdf).
    function esPdfOImagenOWord() {
      return request.resource.contentType != null
        && (request.resource.contentType == 'application/pdf'
            || request.resource.contentType.matches('image/.*')
            || request.resource.contentType == 'application/msword'
            || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document');
    }

    // Avales de vacante (PDF). Solo usuarios internos suben y leen.
    match /avales/{empresa}/{file} {
      allow read: if tieneRol();
      allow write: if tieneRol() && esPdf() && request.resource.size < 10 * 1024 * 1024;
    }

    // Hojas de vida. Las sube el candidato (anónimo) al postularse o el analista.
    // Lectura: el STAFF (con rol) lee cualquiera; el candidato solo el archivo que
    // SUBIÓ ÉL (se estampa uploaderUid en customMetadata). Antes bastaba cualquier
    // sesión, así que un anónimo podía descargar el CV de otro si adivinaba la ruta
    // (revisión 16-jul).
    match /cvs/{vacante}/{file} {
      allow read: if tieneRol()
        || (request.auth != null && resource.metadata.uploaderUid == request.auth.uid);
      allow write: if request.auth != null && esPdf() && request.resource.size < 5 * 1024 * 1024;
    }

    // Carpeta digital del candidato. Sube y lee el analista/GH (con rol).
    match /documentos_candidato/{candidato}/{file} {
      allow read: if tieneRol();
      allow write: if tieneRol() && esPdfOImagenOWord() && request.resource.size < 15 * 1024 * 1024;
    }

    // Documentos que el candidato sube desde su portal público (anónimo).
    // Lectura: el STAFF (con rol) lee cualquiera; el candidato solo lo que subió él
    // (uploaderUid en customMetadata). Antes cualquier sesión podía leer los docs
    // de otro candidato conociendo su token+ruta (revisión 16-jul).
    match /portal_docs/{token}/{file} {
      allow read: if tieneRol()
        || (request.auth != null && resource.metadata.uploaderUid == request.auth.uid);
      allow write: if request.auth != null && esPdfOImagenOWord() && request.resource.size < 10 * 1024 * 1024;
    }

    // Perfil de cargo (PDF) que el staff adjunta al enviar condiciones laborales.
    // Solo usuarios internos (con rol) suben/leen; el correo se adjunta server-side.
    match /perfiles_cargo/{postulacion}/{file} {
      allow read: if tieneRol();
      allow write: if tieneRol() && esPdf() && request.resource.size < 8 * 1024 * 1024;
    }

    // Orden de exámenes médicos (PDF) que el staff adjunta al enviarla al
    // candidato (paso 16). Solo usuarios internos suben/leen; el candidato la
    // recibe adjunta al correo y por la URL de descarga (token) en su portal.
    match /ordenes_examenes/{examen}/{file} {
      allow read: if tieneRol();
      // Los gestores mandan la orden como PDF o imagen (reu 26-jun) → ambos.
      allow write: if tieneRol() && esPdfOImagen() && request.resource.size < 8 * 1024 * 1024;
    }

    // Resultado del examen médico + acta de recomendaciones (PDF/imagen) que los
    // gestores SST (o GH) suben en la plataforma (reu Karen 09-jul). Dato médico
    // sensible (Habeas Data): solo los actores del flujo médico leen/suben — NO
    // lider/apoyo/talentos/documentacion ni el anónimo de la landing.
    match /resultados_examenes/{examen}/{file} {
      allow read: if request.auth != null
        && request.auth.token.rol in ['gh', 'coordinador', 'admin', 'analista', 'gestor'];
      allow write: if request.auth != null
        && request.auth.token.rol in ['gh', 'coordinador', 'admin', 'gestor']
        && esPdfOImagen() && request.resource.size < 15 * 1024 * 1024;
    }

    // PDF de una prueba psicotécnica que el staff sube para enviárselo al
    // integrante (reu 18-ago: los links de PDF en Drive no abrían para el candidato
    // sin cuenta). Solo el staff sube/lee; el integrante lo abre por la URL de
    // descarga (token) desde el correo, igual que la orden de exámenes.
    match /pruebas_docs/{postulacion}/{file} {
      allow read: if tieneRol();
      allow write: if tieneRol() && esPdf() && request.resource.size < 10 * 1024 * 1024;
    }

    // Formato oficial REGENERADO al corregir un campo (Datos Básicos / SAGRILAFT).
    // Lo sube el staff (con rol); cada versión queda con su propio archivo, el
    // anterior NO se borra (trazabilidad de Calidad). Registro en formatos_versiones.
    match /formatos_corregidos/{postulacion}/{file} {
      allow read: if tieneRol();
      allow write: if tieneRol() && esPdf() && request.resource.size < 10 * 1024 * 1024;
    }

    // Todo lo demás: denegado. Antes había un catch-all (read/write si auth!=null)
    // que dejaba a cualquier candidato anónimo leer TODO el bucket (avales,
    // carpetas con cédulas y PII) y sobrescribirlo.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
