rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===== Helpers =====
    function signedIn() { return request.auth != null; }
    function rol() { return request.auth.token.rol; }
    function isAdmin() { return signedIn() && rol() == 'admin'; }
    function isCoord() { return signedIn() && rol() == 'coordinador'; }
    function isGH() { return signedIn() && rol() == 'gh'; }
    function isLider() { return signedIn() && rol() == 'lider'; }
    function isAnalista() { return signedIn() && rol() == 'analista'; }
    function isApoyo() { return signedIn() && rol() == 'apoyo'; }
    // Documentación (Carla, reu 09-jul): rol acotado a Carpetas. Trabaja los
    // documentos de la carpeta igual que GH, pero no es "staff" (no ve avales,
    // exámenes ni el resto). Gestor SST sube exámenes vía callable (Admin SDK),
    // por eso no necesita write directo en las reglas.
    function isDocumentacion() { return signedIn() && rol() == 'documentacion'; }
    function isGestor() { return signedIn() && rol() == 'gestor'; }
    // Gerente por área (reu Karen jul-2026): solo lectura, acotado a las vacantes
    // de SUS unidades. El conjunto de unidades vive en el claim `unidades_gerente`
    // (lista de unidad_id). Ver el scoping del `list` de vacantes más abajo.
    function isGerente() { return signedIn() && rol() == 'gerente'; }
    function unidadDelGerente(unidadId) {
      return 'unidades_gerente' in request.auth.token
        && (unidadId in request.auth.token.unidades_gerente);
    }
    function staff() { return isAdmin() || isCoord() || isGH(); }

    // ===== La frontera real de lectura (auditoría de PII, 15-jul) =====
    //
    // OJO con signedIn(): la landing (/carreras) y el portal (/portal) entran con
    // Auth ANÓNIMA, y un token anónimo cumple `request.auth != null`. Es decir:
    // `read: if signedIn()` NO significa "el equipo" — significa "cualquiera en
    // internet que abra una oferta de trabajo". Con eso se leían cédulas, el
    // SAGRILAFT (cónyuge, PEP, finanzas) y cuentas bancarias.
    //
    // `interno()` es la frontera: sesión REAL (no anónima) + rol ya asignado.
    // Exigir el rol cierra además al Google cualquiera que se autentique sin
    // pertenecer al equipo (el `hd` del login es solo una pista del cliente).
    // Verificado 15-jul: las 25 cuentas de prod tienen el claim `rol`.
    function interno() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && 'rol' in request.auth.token;
    }

    // Datos del CANDIDATO (cédula, contacto, documentos). Fuera: apoyo
    // (IT/compras), talentos y gestor SST — ninguno los necesita para su
    // pantalla y hasta hoy los leían todos.
    function leeCandidato() {
      return interno() && (isLider() || isAnalista() || isCoord() || isAdmin()
        || isGH() || isDocumentacion());
    }
    // El gestor SST NO lee postulaciones: su pantalla de Exámenes resuelve el
    // candidato desde el propio doc `examenes_medicos` (candidato_nombre
    // denormalizado). Antes leía TODO el pipeline —PII de candidatos ajenos a
    // exámenes— sin necesitarlo (revisión 16-jul).
    function leePostulacion() { return leeCandidato(); }

    // PIPELINE de reclutamiento: pruebas, entrevistas, referencias, informes,
    // ternas, decisiones, conceptos. GH queda FUERA — la reu Karen 09-jul pidió
    // que Gestión Humana no viera la gestión interna del equipo de Atracción, y
    // hasta hoy eso solo estaba en la UI (por reglas, Diego leía todo).
    function leePipeline() {
      return interno() && (isLider() || isAnalista() || isCoord() || isAdmin());
    }

    // Un interno que es el LÍDER SOLICITANTE de una vacante puede leer el pipeline
    // de ESA vacante aunque su rol no esté en leePipeline (reu 26-ago: a Diego, C&D
    // /gh, le comparten el concepto de los cargos que le reportan y "no lo deja ver
    // nada"). Scoped por get() a su propia vacante, no abre todo el pipeline a GH.
    function esLiderDeVacante(vacanteId) {
      return interno()
        && vacanteId is string
        && vacanteId != ''
        && get(/databases/$(database)/documents/vacantes/$(vacanteId)).data.lider_uid == request.auth.uid;
    }

    // CARPETA del integrante: SAGRILAFT, datos básicos (cuenta bancaria, salud,
    // hijos), carpeta digital. Exactamente los roles de /carpetas. El líder NO
    // entra: decide sobre la terna, no gestiona la vinculación (sus tabs de
    // carpeta también se ocultan en la UI).
    function leeCarpeta() {
      return interno() && (isAnalista() || isCoord() || isAdmin()
        || isGH() || isDocumentacion());
    }

    // Override POR-USUARIO: secciones de admin concedidas a un usuario no-admin
    // vía el custom claim `secciones_admin` (lista). Ej.: Karen (coordinadora)
    // tiene 'catalogos' para editar empresas/sedes/unidades/cargos sin ser admin.
    // NO cubre seed/integraciones/referidos (esos escriben en configuracion_global,
    // que sigue siendo isAdmin()).
    function tieneSeccion(s) {
      return signedIn()
        && 'secciones_admin' in request.auth.token
        && (s in request.auth.token.secciones_admin);
    }
    function puedeCatalogos() { return isAdmin() || isGH() || tieneSeccion('catalogos'); }

    // Registro público (landing) → el candidato entra con Auth anónima. Para ese
    // origen exigimos consentimiento de tratamiento de datos (Ley 1581 / Habeas
    // Data); los flujos internos (no anónimos) no se ven afectados.
    function esAnonimo() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }
    function aceptoHabeasData() {
      return 'habeas_data' in request.resource.data
        && request.resource.data.habeas_data.aceptado == true;
    }

    function nuevoConAuditoria() {
      return request.resource.data.creado_por == request.auth.uid
        && request.resource.data.actualizado_por == request.auth.uid;
    }
    function preservaCreador() {
      return request.resource.data.creado_por == resource.data.creado_por
        && request.resource.data.creado_en == resource.data.creado_en
        && request.resource.data.actualizado_por == request.auth.uid;
    }

    // ===== Catálogos =====
    match /empresas/{id} {
      allow read: if interno();
      allow create: if puedeCatalogos() && nuevoConAuditoria();
      allow update: if puedeCatalogos() && preservaCreador();
      allow delete: if false;
    }
    match /sedes/{id} {
      allow read: if interno();
      allow create: if puedeCatalogos() && nuevoConAuditoria();
      allow update: if puedeCatalogos() && preservaCreador();
      allow delete: if false;
    }
    match /unidades/{id} {
      allow read: if interno();
      allow create: if puedeCatalogos() && nuevoConAuditoria();
      allow update: if puedeCatalogos() && preservaCreador();
      allow delete: if false;
    }
    match /cargos_catalogo/{id} {
      allow read: if interno();
      // Líder/analista/coord pueden crear cargos al vuelo desde el form
      // "Nueva vacante" cuando el suyo no está en el catálogo. Maribel (GH)
      // refina banda/criticidad después desde /admin/catalogos.
      allow create: if signedIn() && nuevoConAuditoria();
      allow update: if puedeCatalogos() && preservaCreador();
      allow delete: if false;
    }
    match /festivos/{id} {
      allow read: if interno();
      allow write: if isAdmin();
    }
    match /plantillas_comunicacion/{id} {
      allow read: if interno();
      allow write: if isAdmin() || isGH();
    }
    match /plantillas_graficas/{id} {
      allow read: if interno();
      allow write: if isAdmin() || isGH();
    }

    // ===== Usuarios =====
    match /usuarios/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || staff());
      allow create: if isAdmin() && nuevoConAuditoria();
      allow update: if (isAdmin() || request.auth.uid == uid) && preservaCreador();
      allow delete: if false;
    }

    // Pre-asignaciones de rol por correo (gh, apoyo) que hace el staff. Solo se
    // escriben vía callable (preasignarRoles, Admin SDK); el staff las lee en
    // /admin/usuarios. El rol se aplica al primer login (autoasignarRol).
    match /preasignaciones_rol/{email} {
      allow read: if staff();
      allow write: if false;
    }

    // ===== Contadores (sólo Admin SDK) =====
    match /contadores/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ===== Vacantes =====
    match /vacantes/{id} {
      // get totalmente público (sin requerir login ni Anonymous Auth).
      // Decisión 2026-06-01: la landing pública debe abrirse desde
      // cualquier navegador (normal o incógnito), WhatsApp, móvil, etc.
      // Los datos de la vacante (cargo, salario, justificación) no son
      // PII — están destinados a ser compartidos como oferta de trabajo.
      // Para crear postulación sí se requiere signedIn() (anonymous o
      // identificado), pero LEER la vacante no.
      allow get: if true;
      // Confidencialidad por propiedad (Eloy, lanzamiento 2026-07-01):
      // un `lider` SOLO puede listar SUS vacantes (lider_uid == su uid) o el
      // tablero de vacantes abiertas (publicada / en_proceso, que ya son
      // visibles internamente). Cualquier otra consulta de un líder (listar
      // todo, o filtrar por el uid de OTRO líder) queda negada por la base.
      // El resto de roles (admin, coordinador, gh, analista, apoyo) NO se
      // tocan: siguen viendo todo como hasta ahora.
      // El `list` es de uso INTERNO (tableros). El anónimo de la landing no lista
      // vacantes: abre UNA por su id con el `get` de arriba (auditoría 15-jul —
      // antes, al no ser líder, el anónimo pasaba el filtro y listaba todo,
      // incluidos borradores).
      // El `gerente` (reu Karen jul-2026) es solo-lectura acotado: SOLO puede
      // listar las vacantes cuya `unidad_id` está en su claim `unidades_gerente`.
      // Se saca del catch-all `!isLider()` (que dejaba a cualquier no-líder listar
      // todo) para que su alcance sea real, no solo de UI. El resto de roles no
      // cambia.
      allow list: if interno() && (
        (!isLider() && !isGerente())
        || (isLider() && (
              resource.data.lider_uid == request.auth.uid
              || resource.data.estado == 'publicada'
              || resource.data.estado == 'en_proceso'
           ))
        || (isGerente() && unidadDelGerente(resource.data.unidad_id))
      );
      // El aval ya no es obligatorio al crear — el líder puede mandar la
      // solicitud sin él y queda marcada con aval_pendiente=true para que
      // GH/Coord la gestione después. Política tomada 2026-05-26.
      allow create: if (
        (isLider() && request.resource.data.lider_uid == request.auth.uid)
        // Diego (C&D, rol gh) también puede solicitar personal (reu Karen 04-ago):
        // crea su propia vacante (lider_uid == su uid), igual que un líder.
        || (isGH() && request.resource.data.lider_uid == request.auth.uid)
        || isCoord()
        || isAdmin()
      ) && nuevoConAuditoria()
        && request.resource.data.estado == 'borrador'
        && request.resource.data.aval_url is string;
      allow update: if signedIn() && (
        staff()
        || (isAnalista() && (
              resource.data.analista_uid == null
              || resource.data.analista_uid == request.auth.uid
            ))
      ) && preservaCreador()
        // La asignación de analista la hace SOLO la callable asignarAnalista
        // (Admin SDK, staff-only). Ningún cliente puede cambiar analista_uid /
        // analista_nombre por su cuenta — ni una analista autoasignarse vacantes
        // ajenas, ni el perfilamiento auto-asignarse (decisión 2026-06-28).
        && request.resource.data.analista_uid == resource.data.analista_uid
        && request.resource.data.analista_nombre == resource.data.analista_nombre;
      allow delete: if false;
    }

    // Bitácora de reprocesos y novedades de la vacante (petición Karen
    // 2026-06-24). Log append-only: el equipo de Atracción registra, pero
    // nadie edita ni borra → trazabilidad inmutable de por qué un proceso se
    // reprocesa o cambia de estado.
    match /vacante_novedades/{id} {
      allow read: if interno();
      allow create: if (staff() || isAnalista()) && nuevoConAuditoria();
      allow update, delete: if false;
    }

    // ===== Procesos y colecciones derivadas =====
    match /procesos/{id} {
      allow read: if interno();
      allow write: if staff() || (isAnalista());
    }
    match /publicaciones/{id} {
      allow read: if interno();
      allow write: if staff() || isAnalista();
    }
    match /candidatos/{id} {
      allow read: if leeCandidato();
      // Landing pública (anónimo) DEBE aceptar Habeas Data; flujos internos igual.
      allow create: if signedIn() && (!esAnonimo() || aceptoHabeasData());
      allow update: if staff() || isAnalista();
      allow delete: if false;
    }
    match /postulaciones/{id} {
      allow read: if leePostulacion();
      // Landing pública (anónimo) DEBE aceptar Habeas Data; flujos internos igual.
      allow create: if signedIn() && (!esAnonimo() || aceptoHabeasData());
      // BUG 3 (2026-06-24): ningún cliente puede transicionar a 'contratado'
      // directamente — solo la Cloud Function `aprobarCarpeta` (Admin SDK, que
      // valida unicidad de 1 contratado por vacante). Así es imposible tener 2
      // contratados aunque se salten la UI. El resto de updates no cambia.
      allow update: if (staff() || isAnalista() || isDocumentacion())
        && !(request.resource.data.estado == 'contratado'
             && resource.data.estado != 'contratado')
        // Igual que 'contratado': 'repostulado' SOLO lo setea la callable
        // `repostularCandidato` (Admin SDK), que además crea la postulación
        // destino y estampa la traza. Un cliente no puede saltárselo.
        && !(request.resource.data.estado == 'repostulado'
             && resource.data.estado != 'repostulado');
      allow delete: if false;
    }
    match /contactos_candidato/{id} {
      allow read: if false /* sin lectores de cliente: solo Admin SDK */;
      allow write: if staff() || isAnalista();
    }
    match /pruebas/{id} {
      allow read: if leePipeline();
      allow write: if staff() || isAnalista();
    }
    match /entrevistas/{id} {
      allow read: if leePipeline();
      allow write: if staff() || isAnalista() || (isLider() && resource.data.entrevistador_uid == request.auth.uid);
    }
    match /referencias/{id} {
      allow read: if leePipeline();
      allow write: if staff() || isAnalista();
    }
    match /documentos_candidato/{id} {
      allow read: if leeCandidato();
      allow write: if staff() || isAnalista() || isDocumentacion();
    }
    match /informes/{id} {
      allow read: if leePipeline() || esLiderDeVacante(resource.data.vacante_id);
      allow write: if staff() || isAnalista();
    }
    match /ternas/{id} {
      allow read: if false /* sin lectores de cliente: solo Admin SDK */;
      allow write: if staff() || isAnalista();
    }
    match /decisiones/{id} {
      allow read: if leePipeline();
      allow create: if isLider() && request.resource.data.lider_uid == request.auth.uid
        || staff();
      allow update, delete: if false;
    }
    match /validaciones_salariales/{id} {
      allow read: if false /* sin lectores de cliente: solo Admin SDK */;
      allow write: if staff() || isAnalista();
    }
    match /examenes_medicos/{id} {
      // Dato médico sensible (Habeas Data): solo los actores del flujo lo leen
      // (staff + analista + gestor). El anónimo de la landing y roles ajenos
      // (lider/apoyo/talentos/documentacion) quedan fuera.
      allow read: if staff() || isAnalista() || isGestor();
      // El doc lo crea la Cloud Function (paso 15). El cliente solo puede hacer el
      // paso 16 (enviar orden): NUNCA fijar el concepto/decisión ni las transiciones
      // server-only — esas van por registrarResultadoExamen / decisionCulturaExamen
      // (Admin SDK), para que GH no pueda puentear a Diego cuando hay novedad.
      allow create: if false;
      // staff/analista Y el gestor SST (reu Karen 28-jul: los gestores suben y
      // envían la orden, paso 16). Los guardas siguen impidiendo fijar
      // concepto/resultado/novedad/decisión desde el cliente — eso solo por
      // registrarResultadoExamen / decisionCulturaExamen (Admin SDK).
      allow update: if (staff() || isAnalista() || isGestor())
        && !(request.resource.data.estado in ['apto', 'no_apto', 'en_revision_cd'])
        && request.resource.data.get('apto', null) == resource.data.get('apto', null)
        && request.resource.data.get('resultado_url', null) == resource.data.get('resultado_url', null)
        && request.resource.data.get('novedad', null) == resource.data.get('novedad', null)
        && request.resource.data.get('observaciones_gestor', null) == resource.data.get('observaciones_gestor', null)
        && request.resource.data.get('decision_cd', null) == resource.data.get('decision_cd', null);
      allow delete: if false;
    }
    match /carpetas_digitales/{id} {
      allow read: if leeCarpeta();
      allow write: if staff() || isAnalista() || isDocumentacion();
    }
    match /tickets_conexion/{id} {
      allow get: if staff() || isAnalista()
        || (isApoyo() && resource.data.area == request.auth.token.area_apoyo);
      // Mismo caso que notificaciones: el `get` acotaba por área pero el `list`
      // no, así que un apoyo de bodega listaba los tickets de IT y compras
      // (auditoría 15-jul). TicketsPage ya fuerza `where('area','==',...)` para
      // el rol apoyo, así que su tablero no cambia.
      allow list: if staff() || isAnalista()
        || (isApoyo() && resource.data.area == request.auth.token.area_apoyo);
      allow create: if staff() || isAnalista();
      allow update: if staff() || isAnalista()
        || (isApoyo() && resource.data.area == request.auth.token.area_apoyo);
      allow delete: if false;
    }

    match /busquedas_sourcing/{id} {
      allow read: if interno();
      allow write: if false; // solo Cloud Functions vía Admin SDK
    }

    // ===== Referidos internos (módulo v1, 2026-06-03) =====
    // Auditoría de cada vez que se "activan referidos" para una vacante.
    // Solo escribe la callable generarInvitacionesReferidos.
    match /referidos_generaciones/{id} {
      allow read: if interno();
      allow write: if false;
    }
    // Mapeo slug → cédula del técnico. El comentario anterior afirmaba que "la
    // cédula nunca llega al cliente directamente" — pero `get: if true` la
    // entregaba a cualquiera con el slug, y `list` permitía volcar el mapeo de
    // TODA la plantilla, derrotando el diseño del slug aleatorio (auditoría
    // 15-jul). La landing NO lee esta colección: la resuelve la callable
    // `resolverRefSlug` (Admin SDK), que es el único acceso legítimo.
    match /referidos_links/{slug} {
      allow read, write: if false;
    }
    // Portal del candidato (público, sin login). El cliente NUNCA lee el token
    // directamente: la callable `resolverPortalToken` lo resuelve con Admin SDK.
    // Server-only en ambos sentidos.
    match /portal_candidato_tokens/{token} {
      allow read, write: if false;
    }
    // Documentos que el candidato sube desde su portal. Los escribe la callable
    // registrarDocumentoPortal (Admin SDK). Los leen quienes trabajan la carpeta:
    // analista + GH + Documentación (Carla) — sin isDocumentacion, Carla abría la
    // carpeta y el panel "Aportados por el integrante · portal" desaparecía con un
    // permission-denied (revisión 16-jul). leeCarpeta() cubre exactamente a ese grupo.
    match /documentos_portal/{id} {
      allow read: if leeCarpeta();
      allow write: if false;
    }
    // Técnicos que pidieron no recibir más invitaciones. Solo admin edita.
    match /referidos_optouts/{cedula} {
      allow read: if interno() && (isAdmin() || isGH());
      allow create, update: if isAdmin() || isGH();
      allow delete: if isAdmin();
    }
    // Configuración del módulo (Sheet ID, mapping de columnas).
    // Solo 1 doc: `configuracion_global/referidos`.
    match /configuracion_global/{id} {
      allow read: if interno();
      allow write: if isAdmin();
    }

    match /debida_diligencia/{id} {
      allow read: if leeCarpeta();
      allow create: if isAnalista() || staff();
      allow update: if isAnalista() || staff();
      allow delete: if false;
    }

    match /datos_basicos_integrante/{id} {
      allow read: if leeCarpeta();
      allow create: if isAnalista() || staff();
      allow update: if isAnalista() || staff();
      allow delete: if false;
    }

    match /solicitudes_integrante/{id} {
      allow read: if leePipeline();
      allow create: if isAnalista() || staff();
      allow update: if isAnalista() || staff();
      allow delete: if false;
    }

    match /conceptos_atraccion/{id} {
      allow read: if leePipeline() || esLiderDeVacante(resource.data.vacante_id);
      allow create: if isAnalista() || staff();
      allow update: if isAnalista() || staff();
      allow delete: if false;
    }

    // ===== Transversales =====
    match /ans_seguimiento/{id} {
      allow read: if false /* sin lectores de cliente: solo Admin SDK */;
      allow write: if staff() || isAnalista();
    }
    // Bitácora inmutable. La escriben SOLO las Cloud Functions (Admin SDK, que no
    // pasa por reglas): ningún archivo de src/ toca 'eventos'. El `create: if
    // signedIn()` anterior no habilitaba nada nuestro y sí dejaba al anónimo de
    // la landing inyectar documentos en la bitácora que el staff lee como fuente
    // de verdad para auditar (auditoría 15-jul).
    match /eventos/{id} {
      allow read: if staff();
      allow create, update, delete: if false;
    }
    // Versiones de los formatos controlados por Calidad (Datos Básicos / SAGRILAFT)
    // al corregir un campo: historial inmutable (quién/cuándo/qué/PDF por versión).
    // Solo la callable `regenerarFormatoOficial` (Admin SDK) escribe; staff lee.
    match /formatos_versiones/{id} {
      // Lectura para quienes trabajan la carpeta (staff + analista + Documentación):
      // los tabs Datos Básicos / Debida Diligencia muestran el historial de
      // correcciones, y sin isDocumentacion Carla generaba un permission-denied al
      // abrirlos (revisión 16-jul). Escritura solo la callable.
      allow read: if leeCarpeta() || isAnalista();
      allow write: if false;
    }
    match /notificaciones/{id} {
      allow get: if interno() && resource.data.destinatario_uid == request.auth.uid;
      // El `list` DEBE filtrar por destinatario igual que el `get`: si no, el
      // control de arriba es decorativo — cualquiera (incluido el anónimo de la
      // landing) volcaba el inbox de todos, con nombres de candidatos y
      // resultados de exámenes en el título (auditoría 15-jul). La campanita ya
      // consulta con `where('destinatario_uid','==',uid)`, así que no cambia nada
      // para el usuario.
      allow list: if interno() && resource.data.destinatario_uid == request.auth.uid;
      allow update: if interno() && resource.data.destinatario_uid == request.auth.uid;
      // staff + analista pueden notificar (ej. el analista avisa al líder que la
      // terna está lista para su revisión). El analista no es staff() pero sí
      // dispara notificaciones legítimas del flujo.
      allow create: if staff() || isAnalista();
      allow delete: if false;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
